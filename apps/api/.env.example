# --- Server ---
PORT=3000
# Comma-separated list of allowed SPA origins for CORS
CORS_ORIGINS=http://localhost:5173


AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GRAPH_SCOPE=https://graph.microsoft.com/User.ReadBasic.All

# Single partner domain appended to the username typed by the admin (Option A)
TARGET_INVITE_DOMAIN=

INVITE_JWT_SECRET=jwt-secret-key-2026
INVITE_JWT_EXPIRES=3d

# Base URL of the SPA; invite URL is APP_BASE_URL/accept-invite?token=...
APP_BASE_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=entra_invite
DB_SYNCHRONIZE=true

# --- Initial admin seed (created on boot if not present) ---
# Use the local part only; domain is appended from TARGET_INVITE_DOMAIN
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=

# --- DEV ONLY: skip sign-in, acquire admin token via ROPC (username/password) ---
DEV_MODE=true
DEV_ADMIN_USERNAME=
DEV_ADMIN_PASSWORD=
